# Razorpay Payment Link for the Rs 60/month plan (create in Razorpay Dashboard > Payment Links / Subscriptions)
VITE_RAZORPAY_LINK=https://rzp.io/l/your-link

# OPTIONAL - powers the AI pitch generator (server-side only, never exposed to browsers)
# 1. Create a free key at https://aistudio.google.com (Get API key)
# 2. Vercel dashboard > your project > Settings > Environment Variables > add GEMINI_API_KEY
# 3. Redeploy. Without this, the generator still works using built-in offline templates.
GEMINI_API_KEY=
